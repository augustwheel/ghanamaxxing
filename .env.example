# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by the CLI seed import. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (used for canonical links and share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a long random string used to hash visitor IPs for Ayekoo spam limits.
# Defaults to the service role key if unset.
AYEKOO_SALT=

# Optional: alert the team when someone sends a form (Add yours, claim, removal, suggested edit). The n8n workflow in
# n8n/ghanamaxxing-alerts.json emails it to Gmail. Alerts stay off until both are set.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# The n8n workflow that emails people who submit a listing (n8n/ghanamaxxing-maker-emails.json). Uses the same secret.
MAKER_EMAIL_WEBHOOK_URL=
