# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by the CLI seed import. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (used for canonical links and share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a long random string used to hash visitor IPs for Ayekoo spam limits.
# Defaults to the service role key if unset.
AYEKOO_SALT=
